<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="false">
    <testsuites>
        <testsuite name="AuthUsers">
            <directory>tests/Unit/AuthUsers</directory>
        </testsuite>
        <testsuite name="InventoryProducts">
            <directory>tests/Unit/InventoryProducts</directory>
        </testsuite>
        <testsuite name="PosSalesBilling">
            <directory>tests/Unit/PosSalesBilling</directory>
        </testsuite>
        <testsuite name="ReportsForecasting">
            <directory>tests/Unit/ReportsForecasting</directory>
        </testsuite>
        <testsuite name="NotificationsAuditHelpers">
            <directory>tests/Unit/NotificationsAuditHelpers</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
</phpunit>
